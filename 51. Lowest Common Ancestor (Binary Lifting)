Concepts: Trees + sparse jumping

-----------------------------------------------------------

LOG = 20

n = 7

tree = {
    0: [1, 2],
    1: [3, 4],
    2: [5, 6],
    3: [],
    4: [],
    5: [],
    6: []
}

up = [[-1] * LOG for _ in range(n)]
depth = [0] * n


def dfs(node, parent):
    up[node][0] = parent

    for i in range(1, LOG):
        if up[node][i - 1] != -1:
            up[node][i] = up[up[node][i - 1]][i - 1]

    for nei in tree[node]:
        depth[nei] = depth[node] + 1
        dfs(nei, node)


dfs(0, -1)


def lca(a, b):
    if depth[a] < depth[b]:
        a, b = b, a

    diff = depth[a] - depth[b]

    for i in range(LOG):
        if diff & (1 << i):
            a = up[a][i]

    if a == b:
        return a

    for i in reversed(range(LOG)):
        if up[a][i] != up[b][i]:
            a = up[a][i]
            b = up[b][i]

    return up[a][0]


print(lca(3, 4))
print(lca(3, 5))
