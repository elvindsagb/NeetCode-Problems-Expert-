Concepts: Tree DS, range queries

----------------------------------------------------------------------------------------------

class SegmentTree:
    def __init__(self, nums):
        self.n = len(nums)
        self.tree = [0] * (4 * self.n)
        self.build(nums, 0, 0, self.n - 1)

    def build(self, nums, idx, l, r):
        if l == r:
            self.tree[idx] = nums[l]
            return
        mid = (l + r) // 2
        self.build(nums, 2*idx+1, l, mid)
        self.build(nums, 2*idx+2, mid+1, r)
        self.tree[idx] = self.tree[2*idx+1] + self.tree[2*idx+2]

    def update(self, idx, l, r, pos, val):
        if l == r:
            self.tree[idx] = val
            return
        mid = (l + r) // 2
        if pos <= mid:
            self.update(2*idx+1, l, mid, pos, val)
        else:
            self.update(2*idx+2, mid+1, r, pos, val)
        self.tree[idx] = self.tree[2*idx+1] + self.tree[2*idx+2]

    def query(self, idx, l, r, ql, qr):
        if ql > r or qr < l:
            return 0
        if ql <= l and r <= qr:
            return self.tree[idx]
        mid = (l + r) // 2
        return self.query(2*idx+1, l, mid, ql, qr) + \
               self.query(2*idx+2, mid+1, r, ql, qr)


nums = [1,3,5,7,9,11]
st = SegmentTree(nums)
print(st.query(0,0,len(nums)-1,1,3))
