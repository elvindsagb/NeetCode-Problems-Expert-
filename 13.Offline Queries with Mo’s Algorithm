import math

def mos_algorithm(arr, queries):
    n = len(arr)
    block = int(math.sqrt(n))

    queries = sorted(enumerate(queries),
                     key=lambda x: (x[1][0]//block, x[1][1]))

    freq = {}
    curr_ans = 0
    res = [0]*len(queries)

    l = r = 0

    def add(x):
        nonlocal curr_ans
        freq[x] = freq.get(x, 0) + 1
        if freq[x] == 1:
            curr_ans += 1

    def remove(x):
        nonlocal curr_ans
        freq[x] -= 1
        if freq[x] == 0:
            curr_ans -= 1

    for i, (ql, qr) in queries:
        while r <= qr:
            add(arr[r])
            r += 1
        while r > qr+1:
            r -= 1
            remove(arr[r])
        while l < ql:
            remove(arr[l])
            l += 1
        while l > ql:
            l -= 1
            add(arr[l])

        res[i] = curr_ans

    return res


arr = [1,1,2,1,3]
queries = [(0,4),(1,3),(2,4)]
print(mos_algorithm(arr, queries))
