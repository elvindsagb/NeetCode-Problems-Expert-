def booth(s):
    s += s

    n = len(s)

    i = 0
    j = 1
    k = 0

    while i < n // 2 and j < n // 2 and k < n // 2:

        if s[i + k] == s[j + k]:
            k += 1
            continue

        if s[i + k] > s[j + k]:
            i = i + k + 1

            if i <= j:
                i = j + 1
        else:
            j = j + k + 1

            if j <= i:
                j = i + 1

        k = 0

    return min(i, j)

s = "bbaaccaadd"

idx = booth(s)

print(s[idx:] + s[:idx])
