def zeta_transform(f, n):
    f = f[:]

    for bit in range(n):
        for mask in range(1 << n):
            if mask & (1 << bit):
                f[mask] += f[mask ^ (1 << bit)]

    return f


f = [1,2,3,4]
print(zeta_transform(f, 2))
