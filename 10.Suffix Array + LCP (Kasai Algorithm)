def build_suffix_array(s):
    n = len(s)
    suffixes = [(s[i:], i) for i in range(n)]
    suffixes.sort()
    return [idx for (_, idx) in suffixes]


def kasai_lcp(s, sa):
    n = len(s)
    rank = [0]*n
    for i, suffix in enumerate(sa):
        rank[suffix] = i

    lcp = [0]*n
    k = 0

    for i in range(n):
        if rank[i] == 0:
            continue
        j = sa[rank[i] - 1]
        while i+k < n and j+k < n and s[i+k] == s[j+k]:
            k += 1
        lcp[rank[i]] = k
        if k:
            k -= 1

    return lcp


s = "banana"
sa = build_suffix_array(s)
lcp = kasai_lcp(s, sa)

print("Suffix Array:", sa)
print("LCP Array:", lcp)
