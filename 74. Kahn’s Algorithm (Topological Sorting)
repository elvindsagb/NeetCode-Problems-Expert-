from collections import deque

def topo_sort(graph):
    indegree = {u:0 for u in graph}

    for u in graph:
        for v in graph[u]:
            indegree[v] += 1

    q = deque([
        u for u in indegree
        if indegree[u] == 0
    ])

    result = []

    while q:

        u = q.popleft()

        result.append(u)

        for v in graph[u]:
            indegree[v] -= 1

            if indegree[v] == 0:
                q.append(v)

    return result


graph = {
    0:[1,2],
    1:[3],
    2:[3],
    3:[]
}

print(topo_sort(graph))
