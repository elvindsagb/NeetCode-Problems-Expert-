Concepts: Linear recurrence detection

----------------------------------------------------------------------------------

MOD = 10**9 + 7

def berlekamp_massey(sequence):
    n = len(sequence)
    C = [1]
    B = [1]

    L = 0
    m = 1
    b = 1

    for i in range(n):
        d = sequence[i]

        for j in range(1, L + 1):
            d += C[j] * sequence[i - j]

        d %= MOD

        if d == 0:
            m += 1
            continue

        T = C[:]
        coef = d * pow(b, MOD - 2, MOD) % MOD

        while len(C) < len(B) + m:
            C.append(0)

        for j in range(len(B)):
            C[j + m] = (C[j + m] - coef * B[j]) % MOD

        if 2 * L <= i:
            L = i + 1 - L
            B = T
            b = d
            m = 1
        else:
            m += 1

    return C


seq = [1,1,2,3,5,8,13]
print(berlekamp_massey(seq))
