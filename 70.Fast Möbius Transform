Concepts: Bitmask DP + inclusion exclusion

------------------------------------------------------------------------

def fast_mobius_transform(f, n):

    for bit in range(n):

        for mask in range(1 << n):

            if mask & (1 << bit):
                f[mask] -= f[
                    mask ^ (1 << bit)
                ]

    return f


f = [1,2,3,4]

print(
    fast_mobius_transform(
        f,
        2
    )
)
