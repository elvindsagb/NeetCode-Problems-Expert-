Concepts: Critical Nodes in Graphs

-------------------------------------------------------------------------------------------------

def articulation_points(graph):
    n = len(graph)

    disc = [-1] * n
    low = [-1] * n

    timer = 0

    result = set()

    def dfs(u, parent):
        nonlocal timer

        children = 0

        disc[u] = low[u] = timer
        timer += 1

        for v in graph[u]:

            if disc[v] == -1:

                children += 1

                dfs(v, u)

                low[u] = min(low[u], low[v])

                if parent != -1 and low[v] >= disc[u]:
                    result.add(u)

            elif v != parent:
                low[u] = min(low[u], disc[v])

        if parent == -1 and children > 1:
            result.add(u)

    dfs(0, -1)

    return result


graph = {
    0:[1,2],
    1:[0,2],
    2:[0,1,3],
    3:[2,4],
    4:[3]
}

print(articulation_points(graph))
