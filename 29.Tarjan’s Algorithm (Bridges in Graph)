Concepts: Low-link values + DFS

-----------------------------------------------------------------------------------------------------

def find_bridges(n, graph):
    time = 0
    disc = [-1]*n
    low = [-1]*n
    bridges = []

    def dfs(u, parent):
        nonlocal time
        disc[u] = low[u] = time
        time += 1

        for v in graph[u]:
            if v == parent:
                continue
            if disc[v] == -1:
                dfs(v, u)
                low[u] = min(low[u], low[v])
                if low[v] > disc[u]:
                    bridges.append((u, v))
            else:
                low[u] = min(low[u], disc[v])

    for i in range(n):
        if disc[i] == -1:
            dfs(i, -1)

    return bridges


graph = {
    0: [1],
    1: [0,2,3],
    2: [1],
    3: [1,4],
    4: [3]
}

print(find_bridges(5, graph))
