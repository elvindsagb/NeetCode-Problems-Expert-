Concepts: Binary search on answer space

----------------------------------------------------------------------------------

def kthSmallest(matrix, k):
    n = len(matrix)

    def count_less_equal(x):
        count = 0
        col = n - 1
        for row in range(n):
            while col >= 0 and matrix[row][col] > x:
                col -= 1
            count += col + 1
        return count

    left, right = matrix[0][0], matrix[-1][-1]

    while left < right:
        mid = (left + right) // 2
        if count_less_equal(mid) < k:
            left = mid + 1
        else:
            right = mid

    return left


matrix = [
    [1,5,9],
    [10,11,13],
    [12,13,15]
]
print(kthSmallest(matrix, 8))
