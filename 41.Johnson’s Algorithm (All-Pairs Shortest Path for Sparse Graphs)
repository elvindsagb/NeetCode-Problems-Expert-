Concepts: Bellman-Ford + Dijkstra + reweighting

---------------------------------------------------------------------------------------------------------------------

import heapq

INF = float('inf')

def bellman_ford(n, edges, source):
    dist = [INF] * n
    dist[source] = 0

    for _ in range(n - 1):
        for u, v, w in edges:
            if dist[u] != INF and dist[u] + w < dist[v]:
                dist[v] = dist[u] + w

    return dist


def dijkstra(graph, start):
    dist = {node: INF for node in graph}
    dist[start] = 0

    pq = [(0, start)]

    while pq:
        d, u = heapq.heappop(pq)

        if d > dist[u]:
            continue

        for v, w in graph[u]:
            nd = d + w

            if nd < dist[v]:
                dist[v] = nd
                heapq.heappush(pq, (nd, v))

    return dist


def johnson(graph):
    n = len(graph)

    edges = []

    for u in graph:
        for v, w in graph[u]:
            edges.append((u, v, w))

    bf_edges = edges[:]

    for i in range(n):
        bf_edges.append((n, i, 0))

    h = bellman_ford(n + 1, bf_edges, n)

    new_graph = {u: [] for u in graph}

    for u in graph:
        for v, w in graph[u]:
            new_graph[u].append((v, w + h[u] - h[v]))

    result = {}

    for u in graph:
        d = dijkstra(new_graph, u)

        result[u] = {
            v: d[v] - h[u] + h[v]
            for v in d
        }

    return result


graph = {
    0: [(1, 3), (2, 8)],
    1: [(2, -2)],
    2: [(0, 4)]
}

print(johnson(graph))
