class TrieNode:
    def __init__(self):
        self.children = {}
        self.count = 0

class Trie:

    def __init__(self):
        self.root = TrieNode()

    def insert(self, word):

        node = self.root

        for ch in word:

            if ch not in node.children:
                node.children[ch] = TrieNode()

            node = node.children[ch]

            node.count += 1

    def prefix_count(self, prefix):

        node = self.root

        for ch in prefix:

            if ch not in node.children:
                return 0

            node = node.children[ch]

        return node.count

trie = Trie()

trie.insert("apple")
trie.insert("application")
trie.insert("app")

print(trie.prefix_count("app"))
