Concepts: Range Queries + Divide & Conquer

-------------------------------------------------------------------------------

class WaveletTree:
    def __init__(self, arr, lo, hi):
        self.lo = lo
        self.hi = hi

        if lo == hi or not arr:
            self.left = self.right = None
            return

        mid = (lo + hi) // 2

        self.b = [0]

        left_arr = []
        right_arr = []

        for x in arr:
            self.b.append(self.b[-1] + (x <= mid))

            if x <= mid:
                left_arr.append(x)
            else:
                right_arr.append(x)

        self.left = WaveletTree(left_arr, lo, mid)
        self.right = WaveletTree(right_arr, mid + 1, hi)

    def kth(self, l, r, k):
        if self.lo == self.hi:
            return self.lo

        in_left = self.b[r] - self.b[l - 1]

        if k <= in_left:
            return self.left.kth(
                self.b[l - 1] + 1,
                self.b[r],
                k
            )

        return self.right.kth(
            l - self.b[l - 1],
            r - self.b[r],
            k - in_left
        )


arr = [3, 1, 5, 2, 4]

wt = WaveletTree(arr, min(arr), max(arr))

print(wt.kth(1, 5, 3))
