-------------------------------------------------------------

class Node:
    def __init__(self, val):
        self.val = val
        self.left = None
        self.right = None
        self.parent = None
        self.reversed = False

def is_root(x):
    return not x.parent or (
        x.parent.left != x and
        x.parent.right != x
    )

def push(x):
    if x and x.reversed:
        x.left, x.right = x.right, x.left

        if x.left:
            x.left.reversed ^= True

        if x.right:
            x.right.reversed ^= True

        x.reversed = False

node1 = Node(1)
node2 = Node(2)

node2.parent = node1

print(node2.parent.val)
