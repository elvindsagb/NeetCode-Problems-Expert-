Concepts: Union-Find + Undo Operations

---------------------------------------------------------------------------------------------------------------

class DSURollback:
    def __init__(self, n):
        self.parent = list(range(n))
        self.size = [1] * n
        self.history = []

    def find(self, x):
        while x != self.parent[x]:
            x = self.parent[x]
        return x

    def union(self, a, b):
        a = self.find(a)
        b = self.find(b)

        if a == b:
            self.history.append((-1, -1))
            return

        if self.size[a] < self.size[b]:
            a, b = b, a

        self.history.append((b, self.size[a]))

        self.parent[b] = a
        self.size[a] += self.size[b]

    def rollback(self):
        b, old_size = self.history.pop()

        if b == -1:
            return

        a = self.parent[b]

        self.size[a] = old_size
        self.parent[b] = b


dsu = DSURollback(5)

dsu.union(0, 1)
dsu.union(1, 2)

print(dsu.find(2))

dsu.rollback()

print(dsu.find(2))
