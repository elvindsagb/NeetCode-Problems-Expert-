Concepts: Level graph + blocking flow

----------------------------------------------------------------------------------------------------

from collections import deque

class Dinic:
    def __init__(self, n):
        self.n = n
        self.graph = [[] for _ in range(n)]

    def add_edge(self, u, v, cap):
        self.graph[u].append([v, cap, len(self.graph[v])])
        self.graph[v].append([u, 0, len(self.graph[u]) - 1])

    def bfs(self, s, t, level):
        queue = deque([s])
        level[s] = 0
        while queue:
            u = queue.popleft()
            for v, cap, _ in self.graph[u]:
                if cap > 0 and level[v] < 0:
                    level[v] = level[u] + 1
                    queue.append(v)
        return level[t] >= 0

    def dfs(self, u, t, f, level, it):
        if u == t:
            return f
        for i in range(it[u], len(self.graph[u])):
            it[u] = i
            v, cap, rev = self.graph[u][i]
            if cap > 0 and level[u] < level[v]:
                d = self.dfs(v, t, min(f, cap), level, it)
                if d > 0:
                    self.graph[u][i][1] -= d
                    self.graph[v][rev][1] += d
                    return d
        return 0

    def max_flow(self, s, t):
        flow = 0
        level = [-1]*self.n
        while self.bfs(s, t, level):
            it = [0]*self.n
            while True:
                f = self.dfs(s, t, float('inf'), level, it)
                if not f:
                    break
                flow += f
            level = [-1]*self.n
        return flow


g = Dinic(4)
g.add_edge(0,1,3)
g.add_edge(0,2,2)
g.add_edge(1,2,1)
g.add_edge(1,3,2)
g.add_edge(2,3,4)

print("Max Flow:", g.max_flow(0,3))
