class PushRelabel:
    def __init__(self, n):
        self.n = n
        self.capacity = [[0]*n for _ in range(n)]
        self.flow = [[0]*n for _ in range(n)]

    def add_edge(self, u, v, cap):
        self.capacity[u][v] = cap

    def max_flow(self, source, sink):
        n = self.n
        height = [0]*n
        excess = [0]*n

        height[source] = n

        for v in range(n):
            self.flow[source][v] = self.capacity[source][v]
            self.flow[v][source] = -self.flow[source][v]
            excess[v] = self.capacity[source][v]

        excess[source] = float('inf')

        def push(u, v):
            send = min(excess[u],
                       self.capacity[u][v] - self.flow[u][v])

            self.flow[u][v] += send
            self.flow[v][u] -= send

            excess[u] -= send
            excess[v] += send

        def relabel(u):
            height[u] = min(
                height[v]
                for v in range(n)
                if self.capacity[u][v] - self.flow[u][v] > 0
            ) + 1

        active = [i for i in range(n)
                  if i != source and i != sink]

        while active:
            u = active.pop(0)

            old_height = height[u]

            for v in range(n):
                if excess[u] > 0 and \
                   self.capacity[u][v] - self.flow[u][v] > 0 and \
                   height[u] == height[v] + 1:
                    push(u, v)

            if excess[u] > 0:
                relabel(u)
                active.append(u)

        return sum(self.flow[source])


g = PushRelabel(4)

g.add_edge(0,1,3)
g.add_edge(0,2,2)
g.add_edge(1,3,2)
g.add_edge(2,3,4)

print(g.max_flow(0,3))
