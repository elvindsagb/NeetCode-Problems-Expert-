Concepts: Graphs + heuristics + optimization

------------------------------------------------------------------------------------

import heapq

def heuristic(a, b):
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


def astar(grid, start, goal):
    rows = len(grid)
    cols = len(grid[0])

    pq = [(0, start)]

    g = {start: 0}
    parent = {}

    while pq:
        _, current = heapq.heappop(pq)

        if current == goal:
            path = []

            while current in parent:
                path.append(current)
                current = parent[current]

            path.append(start)

            return path[::-1]

        x, y = current

        for dx, dy in [(1,0),(-1,0),(0,1),(0,-1)]:
            nx, ny = x + dx, y + dy

            if 0 <= nx < rows and 0 <= ny < cols \
               and grid[nx][ny] == 0:

                new_cost = g[current] + 1

                if (nx, ny) not in g or \
                   new_cost < g[(nx, ny)]:

                    g[(nx, ny)] = new_cost

                    f = new_cost + heuristic((nx, ny), goal)

                    heapq.heappush(pq, (f, (nx, ny)))

                    parent[(nx, ny)] = current

    return None


grid = [
    [0,0,0],
    [1,1,0],
    [0,0,0]
]

print(astar(grid, (0,0), (2,2)))
